# Copy to .env.local (git-ignored) and adjust.

# The JTrax backend. localhost works on the iOS simulator; on a real phone use
# the laptop's LAN address (http://192.168.x.x:8790) or the deployed API.
EXPO_PUBLIC_API_URL=http://localhost:8790

# Where the trained chess models are served from (https only). Left unset, the
# Advanced robot (Stockfish) is the only one that plays.
# EXPO_PUBLIC_MODEL_BASE_URL=https://example.com/models
